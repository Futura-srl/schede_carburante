<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!-- Relativo alla visualizzazione della tabella ad alberlo -->
    <record id="res_partner_view_form_update_2" model="ir.ui.view">
        <field name="name">res.partner.form.update.2</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="dipendenti.gtms_res_partner_form_inherit_2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_driver']" position="after">
                <field name="driver_code" invisible="is_driver != True"/>
                <field name="driver_pin" invisible="is_driver != True"/>
            </xpath>
<!--            <xpath expr="//div[@name='button_box']" position="inside">-->
<!--                <button class="oe_stat_button" name="open_fleet_fuel_driver" type="object" icon="fa-credit-card" invisible="[('is_driver', '!=', True)]">-->
<!--                    <span>Tessera carburante</span>-->
<!--                </button>-->
<!--            </xpath>-->
        </field>
    </record>

    <record id="res_partner_view_form_update_inherit" model="ir.ui.view">
        <field name="name">res.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="dipendenti.res_partner_view_form_update" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_employees']" position="before">
                <button class="oe_stat_button" name="open_fleet_fuel_driver" type="object" icon="fa-credit-card" invisible="is_driver != True">
                    <span>Tessera carburante</span>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
